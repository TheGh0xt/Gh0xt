---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import Header from "../../components/header/index.astro";
import { getSanityPostBySlug } from "../../utils/getSanityPostBySlug";
import { portableTextToHtml } from "../../utils/portableTextToHtml";
import { renderMarkdown } from "../../utils/markdownRenderer";

const { slug } = Astro.params;

if (!slug) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

let post: any = null;
try {
  post = await getSanityPostBySlug(slug);
} catch (error) {
  console.error("Failed to load post:", error);
}

if (!post) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=60, stale-while-revalidate=300",
);

const { title, description, publishedAt, body, markdown, mainImage } = post;

const date = publishedAt
  ? new Date(publishedAt).toLocaleDateString("en-US", { dateStyle: "long" })
  : null;
---

<Base
  title={`${title} — Adetoye Anointing`}
  description={description || "Personal articles and thoughts"}
  image={mainImage?.asset?.url}
  type="article"
  publishedAt={publishedAt ? new Date(publishedAt).toISOString() : undefined}
>
  <Header compact={true} />

  <main class="max-w-2xl mx-auto px-4 py-8">
    <a
      href="/articles"
      class="text-xs text-muted hover:text-accent transition-colors"
    >
      ← articles
    </a>

    <header class="mt-8 mb-10">
      <h1 class="text-xl md:text-2xl leading-snug mb-4">{title}</h1>
      {description && <p class="text-sm text-muted leading-relaxed">{description}</p>}

      <div class="mt-4 flex items-center gap-4 text-xs text-muted">
        {date && <time datetime={publishedAt}>{date}</time>}
      </div>
    </header>

    {
      mainImage?.asset?.url && (
        <figure class="mb-10">
          <img
            src={mainImage.asset.url}
            alt={mainImage.alt || title}
            class="w-full h-auto border border-line"
            loading="lazy"
          />
          {mainImage.caption && (
            <figcaption class="mt-3 text-center text-xs text-muted">
              {mainImage.caption}
            </figcaption>
          )}
        </figure>
      )
    }

    <article class="portable-text">
      {
        body && body.length > 0 ? (
          <div set:html={portableTextToHtml(body)} />
        ) : markdown ? (
          <div set:html={renderMarkdown(markdown)} />
        ) : (
          <p class="text-muted">No content available.</p>
        )
      }
    </article>

    <div class="mt-16 pt-8 border-t border-line">
      <a
        href="/articles"
        class="text-xs text-accent hover:opacity-80 transition-opacity"
      >
        ← back to articles
      </a>
    </div>
  </main>
</Base>
