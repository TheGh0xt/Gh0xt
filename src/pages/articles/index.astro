---
export const prerender = true;

import Base from "../../layouts/Base.astro";
import Header from "../../components/header/index.astro";
import { getSanityPosts } from "../../utils/getSanityPosts";

let technicalCount = 0;
let lifeCount = 0;

try {
  const posts = await getSanityPosts();
  technicalCount = posts.filter((p: any) => p.tags?.includes("technical")).length;
  lifeCount = posts.length - technicalCount;
} catch (error) {
  console.error("Failed to load post counts:", error);
}

const paths = [
  {
    href: "/articles/technical",
    title: "Technical",
    blurb:
      "Backend architecture, agentic systems, systems programming, and the things that break in production.",
    count: technicalCount,
  },
  {
    href: "/articles/non-technical",
    title: "Life",
    blurb:
      "History, photography, and the patterns behind systems that aren't software.",
    count: lifeCount,
  },
];
---

<Base
  title="Articles — Adetoye Anointing"
  description="Writing on backend systems, agentic tooling, history and photography."
>
  <Header />
  <main class="max-w-2xl mx-auto px-4 py-8">
    <header class="mb-12">
      <h1 class="text-xl mb-3">Articles</h1>
      <p class="text-sm text-muted leading-relaxed">
        Two tracks. Engineering writing on one side, everything else on the
        other.
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-16">
      {
        paths.map((path) => (
          <a
            href={path.href}
            class="group border border-line hover:border-accent/40 p-6 transition-colors flex flex-col"
          >
            <div class="flex items-baseline justify-between gap-3 mb-3">
              <h2 class="text-base group-hover:text-accent transition-colors">
                {path.title}
              </h2>
              <span class="text-[10px] uppercase tracking-widest text-muted shrink-0">
                {path.count} {path.count === 1 ? "post" : "posts"}
              </span>
            </div>

            <p class="text-sm text-muted leading-relaxed flex-1">
              {path.blurb}
            </p>

            <span class="mt-6 text-xs text-accent">
              read
              <span class="inline-block group-hover:translate-x-1 transition-transform">
                →
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </main>
</Base>
