---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import Header from "../../components/header/index.astro";
import ArticleList from "../../components/ArticleList.astro";
import { getSanityPosts } from "../../utils/getSanityPosts";

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=60, stale-while-revalidate=300",
);

let posts: any[] = [];
try {
  const all = await getSanityPosts();
  posts = all.filter((post: any) => post.tags?.includes("technical"));
} catch (error) {
  console.error("Failed to load technical posts:", error);
}
---

<Base
  title="Technical — Adetoye Anointing"
  description="Backend architecture, agentic systems, systems programming, and the things that break in production."
>
  <Header />
  <main class="max-w-2xl mx-auto px-4 py-8">
    <a
      href="/articles"
      class="text-xs text-muted hover:text-accent transition-colors"
    >
      ← articles
    </a>

    <header class="mt-8 mb-10">
      <h1 class="text-xl mb-3">Technical</h1>
      <p class="text-sm text-muted leading-relaxed">
        Backend architecture, agentic systems, systems programming, and the
        things that break in production.
      </p>
    </header>

    <ArticleList posts={posts} empty="Nothing published here yet." />
  </main>
</Base>
