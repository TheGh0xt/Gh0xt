---
export const prerender = true;

import Base from "../layouts/Base.astro";
import Header from "../components/header/index.astro";
import Prompt from "../components/Prompt.astro";
---

<Base title="404 — Not Found" description="This page does not exist.">
  <Header compact={true} />

  <main
    class="max-w-2xl mx-auto px-4 py-8 min-h-[60vh] flex flex-col justify-center"
  >
    <Prompt path="~" caret={false}>
      <span class="text-fg">cd /nowhere</span>
    </Prompt>

    <p class="mt-6 text-sm text-muted">
      <span class="text-accent">error:</span> no such file or directory
    </p>

    <h1 class="mt-8 text-xl">That page doesn't exist.</h1>

    <p class="mt-3 text-sm text-muted leading-relaxed">
      The link may be stale, or I may have moved something. Either is likely.
    </p>

    <div class="mt-8 flex flex-wrap gap-6 text-xs">
      <a href="/" class="text-accent hover:opacity-80 transition-opacity"
        >→ home</a
      >
      <a href="/articles" class="text-accent hover:opacity-80 transition-opacity"
        >→ articles</a
      >
      <a href="/reach" class="text-accent hover:opacity-80 transition-opacity"
        >→ contact</a
      >
    </div>
  </main>
</Base>
