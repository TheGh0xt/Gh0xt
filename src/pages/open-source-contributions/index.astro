---
export const prerender = true;

import Base from "../../layouts/Base.astro";
import Header from "../../components/header/index.astro";
import Section from "../../components/Section.astro";

const major = [
  {
    name: "librsvg",
    org: "GNOME Foundation",
    url: "https://gitlab.gnome.org/GNOME/librsvg/-/merge_requests/?sort=created_date&state=merged&author_username=Yorubad-Dev",
    summary:
      "A high-performance library used by GNOME and others to render SVG into bitmapped images.",
    detail:
      "Joined through Outreachy and stayed on as an active contributor. My work centred on the SVG2 text layout algorithm, in Rust.",
    points: [
      "Text gathering and precise white-space handling",
      "Core layout algorithm driven by individual glyph positions",
      "Bidirectional embedding and vertical text layouts",
    ],
  },
  {
    name: "cloud-provider-openstack",
    org: "Kubernetes",
    url: "https://github.com/kubernetes/cloud-provider-openstack/pulls?q=is:pr+is:closed+author:TheGh0xt",
    summary:
      "Lets Kubernetes use OpenStack clouds as a provider, managing LoadBalancers, storage and other resources.",
    detail:
      "Focused on reliability: extensive edge-case test coverage, and codebase stability through tagging for OCCM.",
    points: [],
  },
];

const other = [
  {
    name: "pkcs11mod",
    org: "Namecoin",
    url: "https://github.com/namecoin/pkcs11mod/pulls?q=is:pr+is:closed+author:TheGh0xt",
    summary: "A PKCS#11 module for Namecoin, for security and hardware integration.",
  },
];
---

<Base
  title="Open Source — Adetoye Anointing"
  description="Contributions to librsvg (GNOME), Kubernetes cloud-provider-openstack, and Namecoin pkcs11mod."
>
  <Header />
  <main class="max-w-2xl mx-auto px-4 py-8">
    <header class="mb-12">
      <h1 class="text-xl mb-3">Open source</h1>
      <p class="text-sm text-muted leading-relaxed">
        Where my interest in systems meets software other people depend on. Most
        of what I know about infrastructure I learned here rather than at work.
      </p>
    </header>

    <Section title="Key contributions">
      <div class="space-y-10">
        {
          major.map((item) => (
            <div class="border-b border-line pb-8">
              <div class="flex items-baseline justify-between gap-4 mb-2">
                <h3 class="text-base text-accent">{item.name}</h3>
                <span class="text-[10px] uppercase tracking-widest text-muted shrink-0">
                  {item.org}
                </span>
              </div>

              <p class="text-sm text-muted leading-relaxed mb-3">
                {item.summary}
              </p>

              <p class="text-sm leading-relaxed mb-3">{item.detail}</p>

              {item.points.length > 0 && (
                <ul class="text-sm text-muted space-y-1.5 mb-4">
                  {item.points.map((point) => (
                    <li class="relative pl-5">
                      <span class="absolute left-0 text-accent">▸</span>
                      {point}
                    </li>
                  ))}
                </ul>
              )}

              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs text-accent hover:opacity-80 transition-opacity"
              >
                view contributions →
              </a>
            </div>
          ))
        }
      </div>

      <div class="mt-8 text-sm text-muted leading-relaxed">
        <span class="text-accent">★</span> Mentioned in the{" "}
        <a
          href="https://gitlab.gnome.org/GNOME/librsvg/-/releases/2.59.2"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent hover:opacity-80 transition-opacity"
        >
          librsvg 2.59.2 release
        </a>{" "}
        for contributions to the project.
      </div>
    </Section>

    <Section title="Elsewhere">
      <div>
        {
          other.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group block py-4 border-b border-line hover:border-accent/40 transition-colors"
            >
              <div class="flex items-baseline justify-between gap-4">
                <span class="text-sm group-hover:text-accent transition-colors">
                  {item.name}
                </span>
                <span class="text-[10px] uppercase tracking-widest text-muted shrink-0">
                  {item.org}
                </span>
              </div>
              <p class="mt-1.5 text-sm text-muted">{item.summary}</p>
            </a>
          ))
        }
      </div>
    </Section>
  </main>
</Base>
