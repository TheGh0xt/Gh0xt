---
import Header from "../../components/header/index.astro";
import "../../style/index.css";
import { Content as ReachNote } from "../../data/contact.md";

const personal_urls = [
  {
    title: "Github",
    url: "https://github.com/TheGh0xt",
    description:
      "🐙 Basically my code playground, cool stuff are pushed, bugs are squashed, and I'm pushing 🅿️",
  },
  {
    title: "LinkedIn",
    url: "https://linkedin.com/in/adetoye-anointing",
    description:
      "📇 The pretend to be super cool, but it’s mostly just “hey, let’s connect.”",
  },
  {
    title: "Twitter",
    url: "https://x.com/TheGh0xt",
    description:
      "🐦 Savoring the whirlwind of information, with all its ups and downs. reposting geeks posts",
  },
  {
    title: "Email",
    url: "mailto:adetoyeanointing2002@gmail.com",
    description:
      '📧 "Jeremiah said, you will seek me and find me!" so don"t hesistate to shoot me an email. pigeon is out of commission - a single mail can create a lovely productive relationship',
  },
  {
    title: "Matrix",
    url: "https://matrix.to/room/@yorubad_dev:matrix.org",
    description:
      "❄️ An opensource decentralized chat platform for my opensource contribution communication.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>📮 Reach Out</title>
  </head>
  <body>
    <Header />

    <div class="max-w-2xl mx-auto px-4 py-8">
      <div>
        <p>
          <ReachNote />
        </p>
      </div>

      <section id="reach" class="mt-4">
        <h4>📬 Find Me Online</h4>
        <ul>
          {
            personal_urls.map((item) => (
              <li>
                <a
                  href={item.url}
                  target="_blank"
                  class="text-default underline "
                >
                  {item.title}
                </a>
                : {item.description}
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </body>
</html>
