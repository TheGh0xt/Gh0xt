---
export const prerender = true;

import Base from "../../layouts/Base.astro";
import Header from "../../components/header/index.astro";
import Section from "../../components/Section.astro";
import { Content as ReachNote } from "../../data/contact.md";

const channels = [
  {
    title: "Email",
    handle: "adetoyeanointing2002@gmail.com",
    url: "mailto:adetoyeanointing2002@gmail.com",
    description: "Best for work enquiries. I read everything.",
  },
  {
    title: "GitHub",
    handle: "@TheGh0xt",
    url: "https://github.com/TheGh0xt",
    description: "Code, open-source contributions, and whatever I'm building.",
  },
  {
    title: "LinkedIn",
    handle: "adetoye-anointing",
    url: "https://linkedin.com/in/adetoye-anointing",
    description: "Professional history, if you need the formal version.",
  },
  {
    title: "X",
    handle: "@TheGh0xt",
    url: "https://x.com/TheGh0xt",
    description: "Short thoughts on systems, and reposts of smarter people.",
  },
  {
    title: "Matrix",
    handle: "@yorubad_dev:matrix.org",
    url: "https://matrix.to/#/@yorubad_dev:matrix.org",
    description: "For open-source coordination.",
  },
];
---

<Base
  title="Contact — Adetoye Anointing"
  description="Available for backend and AI-systems engineering work — contract or full-time."
>
  <Header />
  <main class="max-w-2xl mx-auto px-4 py-8">
    <article class="content text-sm leading-relaxed mb-12">
      <ReachNote />
    </article>

    <Section title="Channels" id="reach">
      <div>
        {
          channels.map((item) => (
            <a
              href={item.url}
              target={item.url.startsWith("mailto:") ? undefined : "_blank"}
              rel="noopener noreferrer"
              class="group block py-4 border-b border-line hover:border-accent/40 transition-colors"
            >
              <div class="flex items-baseline justify-between gap-4">
                <span class="text-sm text-accent">{item.title}</span>
                <span class="text-xs text-muted shrink-0 truncate">
                  {item.handle}
                </span>
              </div>
              <p class="mt-1.5 text-sm text-muted">{item.description}</p>
            </a>
          ))
        }
      </div>
    </Section>
  </main>
</Base>
