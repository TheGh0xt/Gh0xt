---
export const prerender = true;

import Base from "../layouts/Base.astro";
import Nav from "../components/header/nav.astro";
import Prompt from "../components/Prompt.astro";
import Section from "../components/Section.astro";
import CapabilityRow from "../components/CapabilityRow.astro";
import PostCard from "../components/PostCard.astro";
import Project from "../components/project.astro";
import { Content as Intro } from "../data/intro.md";
import { getSanityPosts } from "../utils/getSanityPosts";

const links = [
  { title: "GitHub", url: "https://github.com/TheGh0xt" },
  { title: "LinkedIn", url: "https://linkedin.com/in/adetoye-anointing" },
  { title: "X", url: "https://x.com/TheGh0xt" },
  {
    title: "Resume",
    url: "https://docs.google.com/document/d/1MWJMxa8oIwBd3aj7gqD0pA2YsKJtLrp1YtoA3JTgMcM/edit?usp=sharing",
  },
];

const capabilities = [
  { label: "Languages", items: ["Go", "Python", "Rust"] },
  { label: "Agentic", items: ["ADK", "LangGraph", "LangChain", "MCP"] },
  { label: "Systems", items: ["Linux", "Kubernetes", "distributed systems"] },
];

let recentPosts: any[] = [];
try {
  const posts = await getSanityPosts();
  recentPosts = posts.filter((p: any) => p.slug?.current).slice(0, 3);
} catch (error) {
  console.error("Failed to load recent posts:", error);
}
---

<Base
  title="Adetoye Anointing — Software Engineer"
  description="Software engineer building backend systems and AI / agentic tooling. Go, Python, Rust. Available for contract or full-time work."
>
  <Nav />

  <div class="max-w-2xl mx-auto px-4 py-8">
    <header class="mt-12 mb-16">
      <Prompt path="~" caret={false}>
        <span class="text-fg">whoami</span>
      </Prompt>

      <div class="mt-6 flex items-start gap-5">
        <img
          src="https://github.com/TheGh0xt.png"
          alt="Adetoye Anointing"
          width="64"
          height="64"
          loading="eager"
          class="rounded-full border border-line shrink-0"
        />

        <div>
          <h1 class="text-2xl leading-tight">Adetoye Anointing</h1>
          <p class="mt-2 text-sm text-muted leading-relaxed">
            Software engineer. Backend systems, and the tooling that lets AI
            agents act on them.
          </p>
        </div>
      </div>

      <div class="mt-6 flex items-center flex-wrap gap-5 text-xs">
        {
          links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted hover:text-accent transition-colors"
            >
              {link.title}
            </a>
          ))
        }
      </div>
    </header>

    <div class="mb-16 border-y border-line py-4">
      {capabilities.map((row) => <CapabilityRow {...row} />)}
    </div>

    <section class="mb-16">
      <article class="content text-sm leading-relaxed">
        <Intro />
      </article>

      <a
        href="/about"
        class="inline-block mt-4 text-xs text-accent hover:opacity-80 transition-opacity"
      >
        → more about me
      </a>
    </section>

    <Project />

    <Section title="Writing">
      {
        recentPosts.length > 0 ? (
          <div>
            {recentPosts.map((post) => (
              <PostCard
                title={post.title}
                slug={post.slug.current}
                description={post.description}
                publishedAt={post.publishedAt}
                viewCount={post.viewCount}
              />
            ))}
          </div>
        ) : (
          <p class="text-sm text-muted">Nothing published yet.</p>
        )
      }

      <a
        href="/articles"
        class="inline-block mt-6 text-xs text-accent hover:opacity-80 transition-opacity"
      >
        → all articles
      </a>
    </Section>

    <Section title="Now">
      <p class="text-sm text-muted leading-relaxed">
        Building <span class="text-fg">PMIE</span>, a prediction market
        intelligence engine — a Go MCP server paired with a Python engine that
        evaluates and orchestrates the agents on top of it. Also building
        <span class="text-fg">Trippy</span>, an agentic application for
        international travel. Still contributing to
        <span class="text-fg">librsvg</span>. Available for backend and
        AI-systems engineering work — contract or full-time.
      </p>
      <p class="mt-3 text-[10px] uppercase tracking-widest text-muted">
        Updated July 2026
      </p>
    </Section>

    <footer class="pt-8 border-t border-line">
      <Prompt path="~" caret={true}>
        <span class="text-fg">
          <a href="/reach" class="hover:text-accent transition-colors">
            contact
          </a>
        </span>
      </Prompt>
    </footer>
  </div>
</Base>
