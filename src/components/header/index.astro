---
import Nav from "./nav.astro";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const personal_urls = [
  { title: "Github", url: "https://github.com/TheGh0xt" },
  { title: "LinkedIn", url: "https://linkedin.com/in/adetoye-anointing" },
  { title: "X", url: "https://x.com/TheGh0xt" },
  {
    title: "Resume",
    url: "https://docs.google.com/document/d/1MWJMxa8oIwBd3aj7gqD0pA2YsKJtLrp1YtoA3JTgMcM/edit?usp=sharing",
  },
];
---

<Nav />

{
  !compact && (
    <header class="text-center mt-12 mb-12">
      <img
        src="https://github.com/TheGh0xt.png"
        alt="Adetoye Anointing"
        width="72"
        height="72"
        loading="eager"
        class="rounded-full mx-auto mb-4 border border-line"
      />

      <h1 class="text-2xl mb-3">Adetoye Anointing</h1>

      <div class="flex items-center flex-wrap gap-4 justify-center text-xs">
        {personal_urls.map((item) => (
          <a
            class="text-muted hover:text-accent transition-colors"
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {item.title}
          </a>
        ))}
      </div>
    </header>
  )
}
