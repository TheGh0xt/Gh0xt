---
import projects from "../data/projects.json";
---

<section class="mb-16 mt-12" id="projects">
  <div class="flex items-center gap-3 mb-4">
    <h2 class="ibm-plex-mono-semibold text-2xl tracking-tight text-white">
      Highlights
    </h2>
    <div class="h-[1px] flex-1 bg-gradient-to-r from-gray-800 to-transparent">
    </div>
  </div>

  <p
    class="text-sm ibm-plex-mono-regular text-gray-400 mb-10 leading-relaxed max-w-xl"
  >
    I've worked on many private services and applications, but these are some of
    the public ones that demonstrate my focus on systems, security, and
    developer experience.
  </p>

  <div class="grid gap-6">
    {
      projects.length > 0 && projects[0].name !== "" ? (
        projects.map((project) => (
          <a
            href={project.url}
            target="_blank"
            class="group block p-6 rounded-xl border border-gray-900 bg-gray-950/20 hover:bg-gray-900/40 hover:border-gray-800 transition-all duration-500 relative overflow-hidden"
          >
            <div class="absolute inset-0 bg-gradient-to-br from-default/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />

            <div class="relative z-10">
              <div class="flex justify-between items-start mb-2">
                <h3 class="text-lg ibm-plex-mono-semibold text-default group-hover:translate-x-1 transition-transform duration-300">
                  {project.name}
                </h3>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-gray-600 group-hover:text-default group-hover:translate-x-1 group-hover:-translate-y-1 transition-all duration-300"
                >
                  <line x1="7" y1="17" x2="17" y2="7" />
                  <polyline points="7 7 17 7 17 17" />
                </svg>
              </div>

              <p class="text-[13px] ibm-plex-mono-regular text-gray-400 leading-relaxed group-hover:text-gray-300 transition-colors duration-300">
                {project.description}
              </p>

              {project.name === "MergeOracle" && (
                <div class="mt-4 flex gap-2">
                  <span class="text-[10px] uppercase tracking-widest px-2 py-0.5 rounded-full border border-default/30 text-default/80 bg-default/5">
                    Active
                  </span>
                  <span class="text-[10px] uppercase tracking-widest px-2 py-0.5 rounded-full border border-blue-500/30 text-blue-400/80 bg-blue-500/5">
                    Go / Gemini AI
                  </span>
                </div>
              )}
            </div>
          </a>
        ))
      ) : (
        <div class="p-12 border border-dashed border-gray-800 rounded-xl text-center bg-gray-950/10">
          <p class="text-xs italic text-gray-600 uppercase tracking-[0.2em]">
            Systems in stabilization phase...
          </p>
        </div>
      )
    }
  </div>
</section>

<style>
  #projects a {
    backdrop-filter: blur(10px);
  }
</style>
