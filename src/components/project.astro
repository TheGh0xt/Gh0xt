---
import Section from "./Section.astro";
import WorkCard from "./WorkCard.astro";
import projects from "../data/projects.json";

const hasProjects = projects.length > 0 && projects[0].name !== "";

const metaFor = (name: string) =>
  name === "MergeOracle" ? ["Active", "Go · Gemini"] : [];
---

<Section title="Selected work" id="projects">
  <p class="text-sm text-muted leading-relaxed mb-6 max-w-xl">
    Public work that shows how I think about systems. Most of what I build is
    private, so these are the ones I can point at.
  </p>

  {
    hasProjects ? (
      <div>
        {projects.map((project) => (
          <WorkCard
            name={project.name}
            description={project.description}
            url={project.url}
            meta={metaFor(project.name)}
          />
        ))}
      </div>
    ) : (
      <div class="p-10 border border-dashed border-line text-center">
        <p class="text-xs text-muted uppercase tracking-[0.2em]">
          Systems in stabilization phase...
        </p>
      </div>
    )
  }
</Section>
