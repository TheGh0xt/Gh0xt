---
interface Props {
  path?: string;
  label?: string;
  caret?: boolean;
}

const { path = "~", label = "adetoye@systems", caret = true } = Astro.props;
---

<div class="flex items-center gap-2 text-xs text-muted">
  <span>{label}</span>
  <span>{path}</span>
  <span class="text-accent">%</span>
  <slot />
  {
    caret && (
      <span
        class="inline-block w-[7px] h-[14px] bg-accent animate-pulse"
        aria-hidden="true"
      />
    )
  }
</div>
