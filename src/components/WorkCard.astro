---
interface Props {
  name: string;
  description: string;
  url?: string;
  meta?: string[];
}

const { name, description, url, meta = [] } = Astro.props;

// Entries without a public repo or live site render as plain blocks rather
// than dead links.
const Tag = url ? "a" : "div";

const linkProps = url
  ? { href: url, target: "_blank", rel: "noopener noreferrer" }
  : {};
---

<Tag
  {...linkProps}
  class="group block py-5 border-b border-line transition-colors"
  class:list={[url ? "hover:border-accent/40" : ""]}
>
  <div class="flex items-baseline justify-between gap-4">
    <h3 class="text-base text-accent">{name}</h3>
    {
      url && (
        <span
          class="text-xs text-muted group-hover:text-accent transition-colors shrink-0"
          aria-hidden="true"
        >
          ↗
        </span>
      )
    }
  </div>

  <p class="mt-2 text-sm text-muted leading-relaxed">{description}</p>

  {
    meta.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2">
        {meta.map((m) => (
          <span class="text-[10px] uppercase tracking-widest text-muted border border-line px-2 py-0.5">
            {m}
          </span>
        ))}
      </div>
    )
  }
</Tag>
