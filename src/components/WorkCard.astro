---
interface Props {
  name: string;
  description: string;
  url?: string;
  caseStudy?: string;
  meta?: string[];
  links?: { label: string; url: string }[];
}

const {
  name,
  description,
  url,
  caseStudy,
  meta = [],
  links = [],
} = Astro.props;

// When a project has a written case study, that is the better destination than
// the repo: it's the argument, and the source is one click further in.
const href = caseStudy ?? url;
const isExternal = !caseStudy && Boolean(url);

// Entries without a case study, a public repo or a live site render as plain
// blocks rather than dead links.
const Tag = href ? "a" : "div";

const linkProps = !href
  ? {}
  : isExternal
    ? { href, target: "_blank", rel: "noopener noreferrer" }
    : { href };
---

<div
  class="border-b border-line transition-colors"
  class:list={[href ? "hover:border-accent/40" : ""]}
>
  <Tag
    {...linkProps}
    class="group block pt-5"
    class:list={[links.length > 0 ? "pb-3" : "pb-5"]}
  >
    <div class="flex items-baseline justify-between gap-4">
      <h3 class="text-base text-accent">{name}</h3>
      {
        href && (
          <span
            class:list={[
              "text-muted group-hover:text-accent transition-colors shrink-0",
              isExternal
                ? "text-xs"
                : "text-[10px] uppercase tracking-widest whitespace-nowrap",
            ]}
            aria-hidden="true"
          >
            {isExternal ? "↗" : "case study →"}
          </span>
        )
      }
    </div>

    <p class="mt-2 text-sm text-muted leading-relaxed">{description}</p>

    {
      meta.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2">
          {meta.map((m) => (
            <span class="text-[10px] uppercase tracking-widest text-muted border border-line px-2 py-0.5">
              {m}
            </span>
          ))}
        </div>
      )
    }
  </Tag>

  {
    links.length > 0 && (
      <div class="flex flex-wrap items-center gap-4 pb-5">
        {links.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs text-muted hover:text-accent transition-colors"
          >
            {link.label} ↗
          </a>
        ))}
      </div>
    )
  }
</div>
