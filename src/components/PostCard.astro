---
interface Props {
  title: string;
  slug: string;
  description?: string;
  publishedAt?: string;
  viewCount?: number;
  tags?: string[];
}

const { title, slug, description, publishedAt, viewCount, tags } = Astro.props;

const date = publishedAt
  ? new Date(publishedAt).toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
    })
  : null;
---

<a
  href={`/articles/${slug}`}
  class="group block py-5 border-b border-line hover:border-accent/40 transition-colors"
>
  <div class="flex items-baseline justify-between gap-4">
    <h3 class="text-base group-hover:text-accent transition-colors">
      {title}
    </h3>
    {date && <time class="text-xs text-muted shrink-0">{date}</time>}
  </div>

  {
    description && (
      <p class="mt-2 text-sm text-muted leading-relaxed line-clamp-2">
        {description}
      </p>
    )
  }

  <div class="mt-3 flex items-center gap-3 text-[10px] uppercase tracking-widest text-muted">
    {tags?.map((tag) => <span>{tag}</span>)}
    {
      typeof viewCount === "number" && viewCount > 0 && (
        <span>{viewCount.toLocaleString()} views</span>
      )
    }
  </div>
</a>
