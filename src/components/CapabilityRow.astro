---
interface Props {
  label: string;
  items: string[];
}

const { label, items } = Astro.props;
---

<div
  class="flex flex-col sm:flex-row sm:items-baseline gap-0.5 sm:gap-4 py-1.5"
>
  <span
    class="text-[10px] uppercase tracking-[0.25em] text-muted w-24 shrink-0"
    >{label}</span
  >
  <span class="text-sm text-fg">{items.join("  ·  ")}</span>
</div>
