---
interface Props {
  title: string;
  id?: string;
  class?: string;
}

const { title, id, class: className = "" } = Astro.props;
---

<section id={id} class={`mb-16 ${className}`}>
  <div class="flex items-center gap-3 mb-6">
    <h2 class="text-[10px] uppercase tracking-[0.25em] text-muted">{title}</h2>
    <div class="h-px flex-1 bg-line"></div>
  </div>
  <slot />
</section>
